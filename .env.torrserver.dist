LAMPA_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
TORRSERVER_DOMAIN=torrserver.example.com
# Optional: second TorrServer and credentials pre-filled in the app (build time)
TORRSERVER_DOMAIN_TWO=
TORRSERVER_LOGIN=
TORRSERVER_PASSWORD=
# Default torrent parser baked into the app at build time: jackett | prowlarr | torrserver
PARSER_TORRENT_TYPE=torrserver
# Parser URL and API key for jackett/prowlarr (default: https://$JACKETT_DOMAIN and $JACKETT_APIKEY)
PARSER_URL=
PARSER_APIKEY=
