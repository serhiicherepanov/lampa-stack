LAMPA_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
TORRSERVER_DOMAIN=torrserver.example.com

# Optional. Non-empty values are baked into the app at build time and override user settings on every start.
# Second TorrServer (domain only, https:// is added):
TORRSERVER_DOMAIN_TWO=
#TORRSERVER_DOMAIN_TWO=torrserver2.example.com
# TorrServer basic auth. When login is set, auth is forced on and hidden from settings.
# The password is visible to anyone in the public app.js.
TORRSERVER_LOGIN=
TORRSERVER_PASSWORD=
#TORRSERVER_LOGIN=admin
#TORRSERVER_PASSWORD=secret

# Default torrent parser: jackett | prowlarr | torrserver
PARSER_TORRENT_TYPE=jackett
# Parser URL and API key for jackett/prowlarr (default: https://$JACKETT_DOMAIN and $JACKETT_APIKEY)
PARSER_URL=
PARSER_APIKEY=
#PARSER_URL=https://prowlarr.example.com
#PARSER_APIKEY=0123456789abcdef0123456789abcdef

# Jackett container (compose profile "jackett")
JACKETT_DOMAIN=jackett.example.com
JACKETT_APIKEY=jackett

# Optional. Comma-separated CIDRs whose X-Forwarded-* headers Traefik trusts (default: Cloudflare ranges)
#TRAEFIK_TRUSTED_IPS=10.0.0.0/8,192.168.0.0/16
